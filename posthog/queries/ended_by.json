{
  "kind": "InsightVizNode",
  "source": {
    "kind": "TrendsQuery",
    "dateRange": {
      "date_from": "-90d"
    },
    "interval": "day",
    "series": [
      {
        "kind": "EventsNode",
        "event": "session_ended",
        "math": "total"
      }
    ],
    "breakdownFilter": {
      "breakdown": "ended_by",
      "breakdown_type": "event"
    },
    "trendsFilter": {
      "display": "ActionsBarValue"
    }
  }
}
