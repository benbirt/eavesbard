{
  "kind": "InsightVizNode",
  "source": {
    "kind": "FunnelsQuery",
    "dateRange": {
      "date_from": "-90d"
    },
    "series": [
      {
        "kind": "EventsNode",
        "event": "$pageview",
        "custom_name": "Visited"
      },
      {
        "kind": "EventsNode",
        "event": "downloads_allowed",
        "custom_name": "Agreed to downloads"
      },
      {
        "kind": "EventsNode",
        "event": "session_started",
        "custom_name": "Began a session"
      },
      {
        "kind": "EventsNode",
        "event": "track_started",
        "custom_name": "Heard a track"
      }
    ],
    "funnelsFilter": {
      "funnelWindowInterval": 1,
      "funnelWindowIntervalUnit": "day",
      "funnelOrderType": "ordered"
    }
  }
}
