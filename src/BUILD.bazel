load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("//tools:ts.bzl", "ts_lib", "ts_tests")

TESTS = glob(["**/*.test.ts"])

ts_lib(
    name = "app",
    srcs = glob(
        ["**/*.ts"],
        exclude = TESTS,
    ),
    deps = [
        "//config:tag_map",
        "//data:tracks",
        "//src/library",
    ],
)

esbuild(
    name = "bundle",
    srcs = [":app"],
    entry_point = "app.js",
    format = "esm",
    minify = True,
    output = "main.js",
    sourcemap = "linked",
    target = "chrome120",
)

# The deployable static site: everything GitHub Pages serves.
copy_to_directory(
    name = "site",
    srcs = [
        "index.html",
        ":bundle",
    ],
    visibility = ["//visibility:public"],
)

ts_tests(
    name = "tests",
    srcs = TESTS,
    deps = [":app"],
)
