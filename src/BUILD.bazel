load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@aspect_rules_js//js:defs.bzl", "js_run_binary")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("//tools:ts.bzl", "ts_lib", "ts_tests")

TESTS = glob(["**/*.test.ts"])

ts_lib(
    name = "app",
    srcs = glob(
        [
            "**/*.ts",
            "**/*.tsx",
        ],
        exclude = TESTS,
    ),
    deps = [
        "//:node_modules/@preact/signals",
        "//:node_modules/preact",
        "//config:tag_map",
        "//data:tracks",
        "//src/library",
    ],
)

esbuild(
    name = "bundle",
    srcs = [":app"],
    entry_point = "app.js",
    format = "esm",
    minify = True,
    output = "main.js",
    sourcemap = "linked",
    target = "chrome120",
)

# index.html with a content hash on the bundle's URL, to defeat stale caches.
js_run_binary(
    name = "stamped_html",
    srcs = [
        "index.html",
        "main.js",
    ],
    outs = ["stamped/index.html"],
    args = [
        "$(rootpath index.html)",
        "$(rootpath main.js)",
        "$(rootpath stamped/index.html)",
    ],
    tool = "//tools:stamp_html",
)

# The deployable static site: everything GitHub Pages serves.
copy_to_directory(
    name = "site",
    srcs = [
        ":bundle",
        ":stamped_html",
    ],
    replace_prefixes = {"stamped/": ""},
    visibility = ["//visibility:public"],
)

ts_tests(
    name = "tests",
    srcs = TESTS,
    deps = [":app"],
)
