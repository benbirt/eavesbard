common --enable_platform_specific_config
common --incompatible_strict_action_env
common --@aspect_rules_ts//ts:skipLibCheck=always
common --@aspect_rules_ts//ts:default_to_tsc_transpiler
test --test_output=errors
# Build only the tests and what they need: the experiment binaries (and their
# own npm packages, such as onnxruntime-node) only when run.
test --build_tests_only

# Setting ASPECT_TOOLS_TELEMETRY to -all turns off aspect_tools_telemetry, pulled
# in through the bazel_style dev dependency for //tools:format. Otherwise it
# reports Bazel and module versions to Aspect. An empty value does not turn it
# off: the module treats it as unset and reports everything.
common --repo_env=ASPECT_TOOLS_TELEMETRY=-all

try-import %workspace%/.bazelrc.user
