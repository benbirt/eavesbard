+/** p shifted by `by` in log-odds (no shift without one). */
+function shifted(p: number, by: number | undefined): number {
+  if (!by) return p;
+  const q = Math.min(Math.max(p, 1e-9), 1 - 1e-9);
+  return 1 / (1 + Math.exp(-(Math.log(q / (1 - q)) + by)));
+}
