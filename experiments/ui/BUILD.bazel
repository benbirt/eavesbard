load("@aspect_rules_js//js:defs.bzl", "js_binary")

# Checks of the real app in headless Chrome (see each script's header):
#   bazel run //experiments/ui:ui_check
#   bazel run //experiments/ui:download_check
#   bazel run //experiments/ui:tabs_check
#   bazel run //experiments/ui:gallery_check
#   bazel run //experiments/ui:analytics_check
[
    js_binary(
        name = name,
        data = [
            "//experiments:node_modules/playwright-core",
            "//experiments:paths",
            "//src:site",
        ],
        entry_point = entry,
    )
    for name, entry in [
        ("download_check", "download-check.mjs"),
        ("ui_check", "ui-check.mjs"),
        ("tabs_check", "tabs-check.mjs"),
        ("gallery_check", "gallery-check.mjs"),
        ("analytics_check", "analytics-check.mjs"),
    ]
]
