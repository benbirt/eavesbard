"""Eavesbard: hands-off ambient music for tabletop RPG sessions."""

module(name = "eavesbard")

bazel_dep(name = "aspect_rules_esbuild", version = "0.27.1")
bazel_dep(name = "aspect_rules_js", version = "3.5.1")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")
bazel_dep(name = "bazel_lib", version = "3.7.2")
bazel_dep(name = "rules_nodejs", version = "6.7.6")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node", dev_dependency = True)
node.toolchain(node_version = "22.22.0")

# pnpm, run through Bazel to change dependencies:
#   bazel run -- @pnpm//:pnpm --dir $PWD add --save-exact --lockfile-only <package>
# (with --dir $PWD/experiments for the experiments' own packages)
pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm", dev_dependency = True)
pnpm.pnpm(pnpm_version_from = "//:package.json")
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm", dev_dependency = True)
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
)

# The experiments' own packages (experiments/package.json), kept apart so the
# app's stay lean: transformers.js with its Node-only parts, and playwright-core.
npm.npm_translate_lock(
    name = "npm_experiments",
    pnpm_lock = "//experiments:pnpm-lock.yaml",
)
use_repo(npm, "npm", "npm_experiments")

typescript = use_extension("@aspect_rules_ts//ts:extensions.bzl", "typescript", dev_dependency = True)
typescript.deps(version_from = "//:package.json")
use_repo(typescript, "npm_typescript")

# PostHog's insights and dashboard as OpenTofu (posthog/), through rules_tofu.
# rules_tofu has no release yet, so it's pinned to a commit.
bazel_dep(name = "rules_tofu", version = "0.0.0")
git_override(
    module_name = "rules_tofu",
    commit = "1b6d5f918b5216da5d1f822a16026bde3f622e14",
    remote = "https://github.com/benbirt/rules_tofu.git",
)

tofu = use_extension("@rules_tofu//toolchain:extensions.bzl", "tofu", dev_dependency = True)
use_repo(tofu, "tofu_toolchains")

# No sha256 pinned: the OpenTofu registry's digests are recorded in
# MODULE.bazel.lock the first time, and reused from there.
tf_providers = use_extension("@rules_tofu//tf/providers:extensions.bzl", "tf_providers", dev_dependency = True)
tf_providers.provider(
    source = "PostHog/posthog",
    version = "1.0.24",
)
use_repo(tf_providers, "tf_providers_posthog_posthog")
