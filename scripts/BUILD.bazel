load("@aspect_rules_js//js:defs.bzl", "js_binary")
load("//tools:ts.bzl", "ts_lib", "ts_tests")

TESTS = glob(["*.test.ts"])

ts_lib(
    name = "scripts",
    srcs = glob(
        ["*.ts"],
        exclude = TESTS,
    ),
    tsconfig = "//:tsconfig_node",
    deps = [
        "//:node_modules/@types/node",
        "//:node_modules/acorn",
        "//src:app",
        "//src/library",
    ],
)

# Regenerates data/tracks.json from tabletopaudio.com (see the file header).
js_binary(
    name = "build_index",
    data = [":scripts"],
    entry_point = "build-index.js",
)

ts_tests(
    name = "tests",
    srcs = TESTS,
    data = [
        "//config:tag_map",
        "//data:tracks",
    ],
    deps = [":scripts"],
)

# Shows how config/tag-map.json sorts the tracks (see the file header).
js_binary(
    name = "library_report",
    data = [":scripts"],
    entry_point = "library-report.js",
)

# Runs scripted transcripts through the real classifier; needs ANTHROPIC_API_KEY.
js_binary(
    name = "classifier_check",
    data = [":scripts"],
    entry_point = "classifier-check.js",
)
